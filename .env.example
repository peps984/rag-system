# app settings
APP_NAME = "RAG System"
APP_VERSION = "0.1.0"
API_HOST = "0.0.0.0"
API_PORT = 8000

# API keys
# OPENAI_KEY = your-key-here (uncomment and add your key)
OPENAI_EMBEDDING_MODEL = "text-embedding-3-small"
EMBEDDING_DIMENSION = 1536

# db settings
DATABASE_URL = "postgresql://raguser:ragpass@localhost:5432/ragdb"

# file upload settings
UPLOAD_DIR = "./uploads"
MAX_FILE_SIZE_MB = 10
ALLOWED_EXTENSIONS = "pdf,docx,txt,md"